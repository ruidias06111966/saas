# ---------------------------------------------------------------------------
# O CONEXÃO roda em dois modos, e os dois são de primeira classe.
#
#   Modo demo   — nenhuma variável definida. Tudo no localStorage, com os 12
#                 perfis fictícios. É o que acontece ao clonar o repositório.
#   Modo online — as duas variáveis VITE_SUPABASE_* definidas. Auth, perfis,
#                 conexões e mensagens vêm do Postgres, protegidos por RLS.
# ---------------------------------------------------------------------------

# Chave da API do Google Gemini (opcional, vale nos dois modos).
# Sem ela o Copiloto usa heurísticas locais determinísticas e o app avisa.
# Pegue a sua em https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Supabase — deixe em branco para continuar no modo demo.
# Painel → Project Settings → API. A chave publicável é pública por natureza:
# quem protege os dados é o RLS (docs/SUPABASE.sql). NUNCA coloque aqui a
# chave `service_role`, que ignora RLS por completo.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
