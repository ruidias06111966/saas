{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    // O teste da assinatura importa um arquivo compartilhado com uma Edge
    // Function, e o Deno exige a extensão `.ts` no import.
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["vite/client"]
  },
  "include": ["**/*.ts", "**/*.tsx"],
  // supabase/functions roda em Deno, com globais e specifiers npm:
  // próprios. Tem o seu próprio tsconfig e não entra no typecheck do app.
  "exclude": ["node_modules", "dist", "supabase/functions"]
}
